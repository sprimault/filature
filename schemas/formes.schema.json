{
  "$comment": "Copyright 2026 Stéphane Primault <sprimault@users.noreply.github.com>. SPDX-License-Identifier: Apache-2.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sprimault/filature/schemas/formes.schema.json",
  "title": "Contrat de formes Filature",
  "description": "Vocabulaire géométrique des greffons d'apparence. Contrat public, versionné indépendamment du jeu. Aucune image : une forme est du texte, ce qui la rend relisible en diff et sans question de provenance.",
  "type": "object",
  "required": [
    "version_formes"
  ],
  "additionalProperties": false,
  "properties": {
    "version_formes": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "forme": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]{1,31}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/forme"
      }
    },
    "palette": {
      "type": "object",
      "description": "Couleurs nommées. Un greffon qui ajoute un nom doit livrer la palette qui le définit.",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]{1,31}$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^#[0-9a-fA-F]{6}$"
      }
    }
  },
  "$defs": {
    "forme": {
      "type": "object",
      "required": [
        "trait"
      ],
      "additionalProperties": false,
      "properties": {
        "role": {
          "enum": [
            "pion",
            "batiment",
            "marqueur"
          ],
          "description": "Il n'existe pas de rôle « sol » : le losange est trace par le moteur et ne se redessine pas. Rue et zones sont des noms de couleurs. Un batiment n'accepte qu'un trait de type prisme, sans emprise : son emprise est le losange de la case."
        },
        "trait": {
          "$ref": "#/$defs/traits"
        },
        "surligne": {
          "$ref": "#/$defs/traits"
        },
        "hors_vue": {
          "$ref": "#/$defs/traits"
        }
      }
    },
    "traits": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "$ref": "#/$defs/trait"
      }
    },
    "trait": {
      "type": "object",
      "required": [
        "type",
        "couleur"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "polygone",
            "cercle",
            "segment",
            "prisme"
          ]
        },
        "points": {
          "$ref": "#/$defs/contour"
        },
        "centre": {
          "$ref": "#/$defs/point"
        },
        "rayon": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "de": {
          "$ref": "#/$defs/point"
        },
        "a": {
          "$ref": "#/$defs/point"
        },
        "epaisseur": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "hauteur": {
          "type": "integer",
          "minimum": 1,
          "maximum": 24
        },
        "couleur": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{1,31}$",
          "description": "Nom de palette. Aucune valeur hexadécimale ici : c'est ce qui rend formes et couleurs indépendantes."
        },
        "contour": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{1,31}$"
        },
        "epaisseur_contour": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "opacite": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "polygone"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "points"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "cercle"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "centre",
              "rayon"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "segment"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "de",
              "a",
              "epaisseur"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "prisme"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "hauteur"
            ]
          }
        }
      ]
    },
    "contour": {
      "type": "array",
      "minItems": 3,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/point"
      }
    },
    "point": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "integer",
        "minimum": -32,
        "maximum": 40
      },
      "description": "x puis y, origine au point d'ancrage au sol, y vers le haut. Les bornes fines dépendent du rôle et sont vérifiées au chargement."
    }
  }
}
