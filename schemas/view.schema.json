{
  "$comment": "Copyright 2026 Stéphane Primault <sprimault@users.noreply.github.com>. SPDX-License-Identifier: Apache-2.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sprimault/filature/schemas/view.schema.json",
  "title": "Vue Filature",
  "description": "Ce qu'un camp a le droit de savoir. Le jeu n'expose rien d'autre, ni à l'interface, ni au reseau, ni a un bot. Genere depuis core.View : ne pas modifier a la main.",
  "$ref": "#/$defs/View",
  "$defs": {
    "CrimeScene": {
      "type": "object",
      "properties": {
        "position": {
          "$ref": "#/$defs/Position"
        },
        "turn": {
          "type": "integer"
        }
      },
      "required": [
        "position",
        "turn"
      ]
    },
    "Effect": {
      "type": "object",
      "properties": {
        "announced": {
          "type": "boolean"
        },
        "duration": {
          "type": "integer"
        },
        "radius": {
          "type": "integer"
        },
        "target": {
          "type": "string"
        },
        "then": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Effect"
          }
        },
        "type": {
          "type": "string"
        },
        "value": {
          "type": "integer"
        }
      },
      "required": [
        "type"
      ]
    },
    "EffectContext": {
      "type": "object",
      "properties": {
        "autre_pion": {
          "type": "integer"
        },
        "cell": {
          "$ref": "#/$defs/Position"
        },
        "piece": {
          "type": "integer"
        },
        "side": {
          "type": "string"
        },
        "zone": {
          "type": "integer"
        }
      },
      "required": [
        "autre_pion",
        "cell",
        "piece",
        "side",
        "zone"
      ]
    },
    "Inspector": {
      "type": "object",
      "properties": {
        "ability": {
          "type": "string"
        },
        "ability_used": {
          "type": "boolean"
        },
        "position": {
          "$ref": "#/$defs/Position"
        },
        "steps_taken": {
          "type": "integer"
        }
      },
      "required": [
        "ability",
        "ability_used",
        "position",
        "steps_taken"
      ]
    },
    "Move": {
      "type": "object",
      "properties": {
        "ability": {
          "type": "string"
        },
        "expense": {
          "type": "string"
        },
        "from": {
          "$ref": "#/$defs/Position"
        },
        "piece": {
          "type": "integer"
        },
        "side": {
          "type": "string"
        },
        "to": {
          "$ref": "#/$defs/Position"
        },
        "turn": {
          "type": "integer"
        },
        "type": {
          "type": "string"
        },
        "zone": {
          "type": "integer"
        }
      },
      "required": [
        "side",
        "turn",
        "type"
      ]
    },
    "Outcome": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string"
        },
        "turn": {
          "type": "integer"
        },
        "winner": {
          "type": "string"
        }
      },
      "required": [
        "reason",
        "turn",
        "winner"
      ]
    },
    "PendingEffect": {
      "type": "object",
      "properties": {
        "announced": {
          "type": "boolean"
        },
        "context": {
          "$ref": "#/$defs/EffectContext"
        },
        "effects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Effect"
          }
        },
        "turn": {
          "type": "integer"
        }
      },
      "required": [
        "announced",
        "context",
        "effects",
        "turn"
      ]
    },
    "Position": {
      "type": "object",
      "properties": {
        "Column": {
          "type": "integer"
        },
        "Row": {
          "type": "integer"
        }
      },
      "required": [
        "Column",
        "Row"
      ]
    },
    "Settings": {
      "type": "object",
      "properties": {
        "centre_radius": {
          "type": "integer"
        },
        "inspectors": {
          "type": "integer"
        },
        "pieces_per_turn": {
          "type": "integer"
        },
        "range": {
          "type": "integer"
        },
        "reveal_period": {
          "type": "integer"
        },
        "size": {
          "type": "integer"
        },
        "stamina": {
          "type": "integer"
        },
        "strangling_period": {
          "type": "integer"
        },
        "strangling_start": {
          "type": "integer"
        },
        "trail_lifetime": {
          "type": "integer"
        },
        "turns": {
          "type": "integer"
        },
        "zones": {
          "type": "integer"
        },
        "zones_left_open": {
          "type": "integer"
        }
      },
      "required": [
        "centre_radius",
        "inspectors",
        "pieces_per_turn",
        "range",
        "reveal_period",
        "size",
        "stamina",
        "strangling_period",
        "strangling_start",
        "trail_lifetime",
        "turns",
        "zones",
        "zones_left_open"
      ]
    },
    "Trail": {
      "type": "object",
      "properties": {
        "direction": {
          "type": "integer"
        },
        "turn": {
          "type": "integer"
        }
      },
      "required": [
        "direction",
        "turn"
      ]
    },
    "View": {
      "type": "object",
      "properties": {
        "announced_effects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PendingEffect"
          }
        },
        "announced_zones": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "crime_scenes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CrimeScene"
          }
        },
        "fugitive_position": {
          "$ref": "#/$defs/Position"
        },
        "inspectors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Inspector"
          }
        },
        "known_trails": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Trail"
          }
        },
        "legal_moves": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Move"
          }
        },
        "next_reveal": {
          "type": "integer"
        },
        "outcome": {
          "$ref": "#/$defs/Outcome"
        },
        "phase": {
          "type": "string"
        },
        "roadblocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Position"
          }
        },
        "sealed_zone": {
          "type": "integer"
        },
        "settings": {
          "$ref": "#/$defs/Settings"
        },
        "side": {
          "type": "string"
        },
        "silence_paid": {
          "type": "boolean"
        },
        "stamina": {
          "type": "integer"
        },
        "streets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Position"
          }
        },
        "turn": {
          "type": "integer"
        },
        "visible_cells": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Position"
          }
        },
        "zones": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Zone"
          }
        }
      },
      "required": [
        "announced_effects",
        "announced_zones",
        "crime_scenes",
        "inspectors",
        "known_trails",
        "legal_moves",
        "next_reveal",
        "phase",
        "roadblocks",
        "settings",
        "side",
        "silence_paid",
        "streets",
        "turn",
        "visible_cells",
        "zones"
      ]
    },
    "Zone": {
      "type": "object",
      "properties": {
        "Cells": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Position"
          }
        },
        "Closed": {
          "type": "boolean"
        },
        "Number": {
          "type": "integer"
        }
      },
      "required": [
        "Cells",
        "Closed",
        "Number"
      ]
    }
  }
}
