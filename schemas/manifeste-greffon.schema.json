{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sprimault/filature/schemas/manifeste-greffon.schema.json",
  "title": "Manifeste de greffon Filature",
  "description": "Contrat public. Versionné indépendamment du jeu : un greffon écrit contre la version 1 doit continuer à charger.",
  "type": "object",
  "required": [
    "nom",
    "version"
  ],
  "additionalProperties": false,
  "properties": {
    "nom": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,31}$",
      "description": "Identifiant du greffon, qui est aussi son nom de dossier."
    },
    "version": {
      "type": "string",
      "description": "Version declaree par l'auteur, sans valeur de preuve."
    },
    "version_effets": {
      "type": "integer",
      "enum": [
        1
      ],
      "description": "Version du vocabulaire d'effets visee. Obligatoire des qu'une capacite, une depense ou un mode est declare."
    },
    "description": {
      "type": "string",
      "description": "Une phrase, affichee dans l'ecran des greffons."
    },
    "regles": {
      "type": "boolean",
      "default": false,
      "description": "Vrai si le greffon modifie les regles. Ceux-la doivent etre identiques des deux cotes en reseau."
    },
    "wasm": {
      "type": "string",
      "description": "Chemin relatif d'un module WebAssembly, pour un generateur de plateau ou une IA."
    },
    "capacite": {
      "$ref": "#/$defs/tableCapacites",
      "description": "Capacites apportees, indexees par identifiant."
    },
    "depense": {
      "$ref": "#/$defs/tableCapacites",
      "description": "Depenses de resistance apportees, meme format qu'une capacite."
    },
    "mode": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/mode"
      },
      "description": "Regles de partie declenchees par le jeu et non par un joueur."
    },
    "bot": {
      "$ref": "#/$defs/bot",
      "description": "Adversaire en processus separe, qui remplace l'IA du jeu."
    },
    "licence": {
      "enum": [
        "MIT",
        "Apache-2.0",
        "CC0-1.0",
        "CC-BY-4.0",
        "CC-BY-SA-4.0",
        "BSD-3-Clause"
      ],
      "description": "Identifiant SPDX. Obligatoire pour un greffon publie, facultatif hors catalogue."
    }
  },
  "allOf": [
    {
      "if": {
        "anyOf": [
          {
            "required": [
              "capacite"
            ]
          },
          {
            "required": [
              "depense"
            ]
          },
          {
            "required": [
              "mode"
            ]
          }
        ]
      },
      "then": {
        "required": [
          "version_effets"
        ]
      }
    },
    {
      "if": {
        "required": [
          "bot"
        ]
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "capacite"
              ]
            },
            {
              "required": [
                "depense"
              ]
            },
            {
              "required": [
                "mode"
              ]
            }
          ]
        }
      }
    }
  ],
  "$defs": {
    "tableCapacites": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/capacite"
      }
    },
    "capacite": {
      "type": "object",
      "required": [
        "nom",
        "camp"
      ],
      "additionalProperties": false,
      "properties": {
        "nom": {
          "type": "string",
          "description": "Libelle affiche au joueur ; l'identifiant est la cle de la table."
        },
        "camp": {
          "enum": [
            "fugitif",
            "inspecteurs"
          ],
          "description": "Camp qui peut la declencher. Une cible incompatible avec lui est refusee au chargement."
        },
        "usages": {
          "type": "integer",
          "minimum": 0,
          "description": "Nombre de declenchements par partie ; absent vaut illimite."
        },
        "cout": {
          "type": "integer",
          "minimum": 0,
          "description": "Points de resistance preleves au declenchement."
        },
        "passive": {
          "type": "boolean",
          "description": "Vrai pour une capacite permanente, qui n'a alors pas de declenchement."
        },
        "declenchement": {
          "enum": [
            "phase_inspecteurs",
            "phase_fugitif",
            "fin_de_tour",
            "contact",
            "revelation"
          ],
          "description": "Moment ou la capacite entre en jeu."
        },
        "effet": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/effet"
          },
          "description": "Les primitives appliquees, dans l'ordre."
        }
      }
    },
    "mode": {
      "type": "object",
      "required": [
        "nom",
        "declenchement",
        "effet"
      ],
      "additionalProperties": false,
      "properties": {
        "nom": {
          "type": "string",
          "description": "Libelle affiche aux deux joueurs quand le mode agit."
        },
        "declenchement": {
          "enum": [
            "phase_inspecteurs",
            "phase_fugitif",
            "fin_de_tour",
            "contact",
            "revelation",
            "etranglement"
          ],
          "description": "Moment ou le mode agit. etranglement n'est ouvert qu'a un mode."
        },
        "effet": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/effet"
          },
          "description": "Ce que le mode applique a chaque declenchement ; la cadence vient des parametres de la partie."
        }
      }
    },
    "bot": {
      "type": "object",
      "required": [
        "camp",
        "commande"
      ],
      "additionalProperties": false,
      "properties": {
        "camp": {
          "enum": [
            "fugitif",
            "inspecteurs"
          ],
          "description": "Camp que le bot pilote."
        },
        "commande": {
          "type": "string",
          "description": "Executable, cherche dans le dossier du greffon puis dans le PATH. Aucun interpreteur n'est fourni."
        },
        "arguments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Arguments passes au lancement."
        },
        "deterministe": {
          "type": "boolean",
          "default": false,
          "description": "Vrai si deux parties sur la meme graine donnent les memes coups. Verifie au catalogue."
        }
      }
    },
    "effet": {
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "deplacer",
            "modifier_portee",
            "modifier_mobilite",
            "bloquer_case",
            "ouvrir_case",
            "reveler_traces",
            "reveler_position",
            "annuler_revelation",
            "partager_vue",
            "couter_resistance",
            "rendre_resistance",
            "effacer_traces",
            "fermer_zone",
            "ouvrir_zone",
            "teleporter",
            "differer",
            "fin_partie"
          ],
          "description": "La primitive appliquee. Liste fermee, decrite dans docs/vocabulaire-effets.md."
        },
        "cible": {
          "enum": [
            "pion_courant",
            "tous_pions",
            "autre_pion",
            "fugitif",
            "case",
            "zone"
          ],
          "description": "Ce sur quoi l'effet porte."
        },
        "valeur": {
          "type": "integer",
          "description": "Amplitude, dans l'unite de la primitive. Le negatif est legal."
        },
        "duree": {
          "type": "integer",
          "minimum": 0,
          "description": "Nombre de tours pendant lesquels l'effet tient ; zero vaut le tour courant."
        },
        "rayon": {
          "type": "integer",
          "minimum": 0,
          "description": "Portee en cases, distance de Tchebychev."
        },
        "annonce": {
          "type": "boolean",
          "description": "Pour differer seulement : l'effet en attente figure alors dans la vue des deux camps."
        },
        "puis": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "description": "Pour differer seulement : les effets appliques a l'echeance.",
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/effet"
              }
            ],
            "properties": {
              "type": {
                "not": {
                  "const": "differer"
                },
                "description": "Toute primitive sauf differer."
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "differer"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "duree",
              "puis"
            ],
            "properties": {
              "duree": {
                "minimum": 1,
                "description": "Nombre de tours de preavis, au moins un."
              }
            }
          },
          "else": {
            "properties": {
              "annonce": false,
              "puis": false
            }
          }
        }
      ]
    }
  }
}
