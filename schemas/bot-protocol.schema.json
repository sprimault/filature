{
  "$comment": "Copyright 2026 Stéphane Primault <sprimault@users.noreply.github.com>. SPDX-License-Identifier: Apache-2.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sprimault/filature/schemas/bot-protocol.schema.json",
  "title": "Protocole de bot Filature",
  "description": "Messages échangés en JSON Lines sur les entrée et sortie standard d'un processus externe. Un objet par ligne. L'IA livrée avec le jeu parle ce protocole : s'il manquait quelque chose, le jeu ne pourrait pas jouer contre lui-même.",
  "oneOf": [
    {
      "$ref": "#/$defs/bonjour"
    },
    {
      "$ref": "#/$defs/joue"
    },
    {
      "$ref": "#/$defs/fin"
    },
    {
      "$ref": "#/$defs/pret"
    },
    {
      "$ref": "#/$defs/coup"
    },
    {
      "$ref": "#/$defs/erreur"
    }
  ],
  "$defs": {
    "bonjour": {
      "description": "jeu -> bot, une fois au démarrage.",
      "type": "object",
      "required": [
        "type",
        "protocol",
        "side",
        "seed",
        "settings"
      ],
      "properties": {
        "type": {
          "const": "bonjour"
        },
        "protocol": {
          "type": "integer",
          "enum": [
            1
          ]
        },
        "side": {
          "enum": [
            "fugitive",
            "inspectors"
          ]
        },
        "seed": {
          "type": "integer",
          "description": "Fournie pour qu'un bot puisse être déterministe sans horloge ni entropie système."
        },
        "settings": {
          "type": "object"
        },
        "plugins": {
          "type": "array",
          "description": "Extensions de règles actives. Un bot qui ne les connaît pas peut refuser de jouer plutôt que de jouer faux.",
          "items": {
            "type": "object",
            "required": [
              "name",
              "version",
              "fingerprint"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "version": {
                "type": "string"
              },
              "fingerprint": {
                "type": "string"
              },
              "rules": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "joue": {
      "description": "jeu -> bot, à chaque tour. vue est l'objet que reçoit l'interface : le bot ne voit jamais la position cachée du fugitif ni sa zone scellée.",
      "type": "object",
      "required": [
        "type",
        "turn",
        "budget_ms",
        "view"
      ],
      "properties": {
        "type": {
          "const": "joue"
        },
        "turn": {
          "type": "integer",
          "minimum": 0
        },
        "budget_ms": {
          "type": "integer",
          "minimum": 1
        },
        "view": {
          "type": "object"
        }
      }
    },
    "fin": {
      "description": "jeu -> bot, puis fermeture de l'entrée standard.",
      "type": "object",
      "required": [
        "type",
        "vainqueur",
        "reason",
        "turn"
      ],
      "properties": {
        "type": {
          "const": "fin"
        },
        "vainqueur": {
          "enum": [
            "fugitive",
            "inspectors"
          ]
        },
        "reason": {
          "type": "string",
          "description": "Le jeu de base en produit quatre : extraction, resistance_epuisee, fugitif_bloque, temps_ecoule. Un greffon de regles peut en produire d'autres, d'ou l'absence de liste fermee ; les greffons actifs sont annonces dans bonjour."
        },
        "turn": {
          "type": "integer"
        }
      }
    },
    "pret": {
      "description": "bot -> jeu, en réponse à bonjour.",
      "type": "object",
      "required": [
        "type",
        "name",
        "version",
        "protocol",
        "deterministic"
      ],
      "properties": {
        "type": {
          "const": "pret"
        },
        "name": {
          "type": "string",
          "maxLength": 64
        },
        "version": {
          "type": "string",
          "maxLength": 32
        },
        "protocol": {
          "type": "integer",
          "enum": [
            1
          ]
        },
        "deterministic": {
          "type": "boolean",
          "description": "Un bot non déterministe reste jouable : le journal enregistre les coups, pas l'état interne. Le déterminisme n'est requis que pour reproduire un défaut et pour entrer dans une passe d'équilibrage."
        },
        "auteur": {
          "type": "string",
          "maxLength": 64
        }
      }
    },
    "coup": {
      "description": "bot -> jeu. Le coup doit figurer tel quel dans coups_legaux : le jeu ne corrige ni n'interprète rien.",
      "type": "object",
      "required": [
        "type",
        "move"
      ],
      "properties": {
        "type": {
          "const": "coup"
        },
        "move": {
          "type": "object"
        }
      }
    },
    "erreur": {
      "description": "bot -> jeu. Le bot déclare qu'il ne peut pas jouer ; la partie s'arrête proprement.",
      "type": "object",
      "required": [
        "type",
        "message"
      ],
      "properties": {
        "type": {
          "const": "erreur"
        },
        "message": {
          "type": "string",
          "maxLength": 512
        }
      }
    }
  }
}
